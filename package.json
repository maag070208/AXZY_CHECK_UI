{
  "name": "business_tracker_management_ui",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5002 --strictPort",
    "server": "vite preview --port 5002 --strictPort",
    "start": "pnpm run build && pnpm run server",
    "build": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:landing": "vite --config vite.landing.config.ts --port 5004 --strictPort",
    "build:landing": "tsc -b && vite build --config vite.landing.config.ts",
    "preview:landing": "vite preview --config vite.landing.config.ts --port 5004 --strictPort",
    "deploy:app": "bash scripts/deploy-app.sh",
    "e2e:build": "vite build --mode e2e",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --coverage",
    "test:e2e": "vitest run --project flows --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@axzydev/axzy_ui_system": "1.7.2",
    "@reduxjs/toolkit": "^2.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react-scroll-sync": "^0.9.0",
    "@vis.gl/react-google-maps": "^1.7.1",
    "ably": "^2.6.5",
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.19",
    "dotenv": "^16.4.7",
    "formik": "^2.4.6",
    "html-to-image": "^1.11.13",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-confirm-alert": "^3.0.6",
    "react-dom": "19.0.0",
    "react-icons": "^5.5.0",
    "react-jwt": "^1.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "tailwindcss": "4.3.3",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^22.13.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react-swc": "3.8.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.34.0"
}
